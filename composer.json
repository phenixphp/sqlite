{
    "name": "phenixphp/sqlite",
    "version": "0.0.1",
    "description": "Asynchronous SQLite client for PHP based on Amp.",
    "license": "MIT",
    "authors": [
        {
            "name": "Omar Barbosa",
            "email": "contacto@omarbarbosa.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "amphp/amp": "^3",
        "amphp/parser": "^1.1",
        "amphp/pipeline": "^1",
        "amphp/sql": "^2",
        "amphp/sql-common": "^2",
        "amphp/parallel": "^2.3"
    },
    "require-dev": {
        "amphp/process": "^2",
        "amphp/file": "^3",
        "phpunit/phpunit": "^9",
        "amphp/phpunit-util": "^3",
        "amphp/php-cs-fixer-config": "^2",
        "phpbench/phpbench": "^1.2.6",
        "phpstan/phpstan": "^2.1",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Phenix\\Sqlite\\": "src"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "test"
        }
    },
    "scripts": {
        "check": [
            "@cs",
            "@test"
        ],
        "cs": "php-cs-fixer fix -v --diff --dry-run",
        "cs-fix": "php-cs-fixer fix -v --diff",
        "test": "@php -dzend.assertions=1 -dassert.exception=1 ./vendor/bin/phpunit"
    }
}
